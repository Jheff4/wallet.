{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * dist

	encode gzip

	# Vite fingerprints these filenames, so they can be cached forever. A missing
	# one 404s here rather than falling through to the HTML shell, which would
	# otherwise surface as a syntax error in the browser.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /fonts/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Client-side routes (e.g. /privacy) have no file on disk, so hand them the
	# HTML shell and let the React router resolve them. The shell must not be
	# cached or clients keep booting the previous build's JS.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
